<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Extracting goes on while the app is not on screen, shown in a
         notification. No storage permission is asked for: archives come
         through the document picker, and what is extracted is written where
         the user pointed, or to the gallery through MediaStore. -->
    <!-- Storages across the network: S3, WebDAV, SFTP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PackwingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Packwing">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- An archive tapped in Files, Gmail or a chat. -->
            <intent-filter android:label="@string/open_with_packwing">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-bzip2" />
                <data android:mimeType="application/x-xz" />
                <data android:mimeType="application/zstd" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.debian.binary-package" />
                <data android:mimeType="application/x-iso9660-image" />
                <!-- A disk image, by the types the system's MIME database gives
                     the containers a virtual machine keeps a disk in. A raw
                     `.img` has no type every provider agrees on, so one tapped
                     in Files may not offer packwing; chosen inside the app it
                     is read like anything else. -->
                <data android:mimeType="application/x-qemu-disk" />
                <data android:mimeType="application/x-vhd-disk" />
                <data android:mimeType="application/x-virtualbox-vhd" />
                <data android:mimeType="application/x-vhdx-disk" />
                <data android:mimeType="application/x-vmdk-disk" />
                <data android:mimeType="application/x-virtualbox-vmdk" />
                <data android:mimeType="application/x-vdi-disk" />
                <data android:mimeType="application/x-virtualbox-vdi" />
                <data android:mimeType="application/vnd.efi.img" />
                <!-- A Windows image, the one type the system's MIME database
                     gives `.wim` and `.swm`. An `.esd` has none. -->
                <data android:mimeType="application/x-ms-wim" />
            </intent-filter>

            <!-- Share › packwing, from any app. -->
            <intent-filter android:label="@string/open_with_packwing">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Keeps extracting and making archives going while the app is in the
             background: the notification shows how far it got. -->
        <service
            android:name=".ExtractService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands a file of an archive, written to the cache, to another app:
             to preview it or send it on. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
