<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this is what shows before it does, and the
         transparent bars it draws behind (MainActivity, edge to edge).
         values-night has the dark one. -->
    <style name="Theme.Packwing" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
