<?xml version="1.0" encoding="utf-8"?>
<!--
  The package that puts packwing in Windows 11's own right-click menu: a
  package with external location (Microsoft's "Grant package identity by
  packaging with external location"), whose files are packwing's folder as
  installed. It declares context-menu-rs's native extension,
  context-menu-packwing.dll, beside packwing.exe; the extension shows the menu
  packwing installs (src/right_click.rs). See context-menu-rs's docs/windows.md.

  The installer (installer.nsi) writes @VERSION@ (four numbers) and registers
  it, unsigned: Windows takes it where Developer Mode is on, and refuses it
  elsewhere, where packwing's menu stays in the classic one ("Show more
  options"). Signed, its Publisher must be the certificate's subject.

  The Extensions are context_menu::windows::package_extensions("packwing")
  (a test in src/right_click.rs holds them to it).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 rescap com">
  <Identity Name="HivePaaS.packwing" Publisher="CN=HivePaaS" Version="@VERSION@" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>packwing</DisplayName>
    <PublisherDisplayName>HivePaaS</PublisherDisplayName>
    <Logo>logo50.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="packwing" Executable="packwing.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="packwing" Description="File archiver that puts every core to work and opens archives safely" BackgroundColor="transparent" Square150x150Logo="logo150.png" Square44x44Logo="logo44.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ContextMenuRspackwing" Clsid="AC1A75AA-BC84-59DB-BD47-0E295821318E" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ContextMenuRspackwing" Clsid="AC1A75AA-BC84-59DB-BD47-0E295821318E" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="packwing">
              <com:Class Id="AC1A75AA-BC84-59DB-BD47-0E295821318E" Path="context-menu-packwing.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
